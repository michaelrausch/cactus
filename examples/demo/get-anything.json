{
  "title": "Get anything",
  "description": "Uses {{token}} captured by Login via bearer auth, and checks httpbin echoed it back.",
  "method": "GET",
  "url": "{{baseUrl}}/anything?q=hello&page=1",
  "headers": {},
  "disabledHeaders": {
    "X-Debug": "1"
  },
  "auth": {
    "type": "bearer",
    "token": "{{token}}"
  },
  "body": null,
  "expect": {
    "status": 200,
    "json": {
      "$.args.q": "hello",
      "$.headers.Authorization": "Bearer demo"
    }
  }
}
