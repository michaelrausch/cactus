---
import "../styles/global.css";
import { downloads } from "../downloads";

const flowPoints = [
  { title: "Steps", body: "Requests, prompts, pick lists, polling, waits, webhooks, Slack, notifications, and other flows." },
  { title: "Critters", body: "Personas with their own variables, secrets and login flow. If a request gets a 401, the critter logs in again and retries." },
  { title: "Schedules", body: "Run a flow every few minutes and get an alert if it starts failing, recovers, or a value you're watching changes." },
  { title: "AI agents", body: "Agents can run your flows and requests over MCP using your secrets, without ever seeing them. Secret values are kept out of everything the agent gets back." },
  { title: "Captures", body: "Grab a token or ID from one response and use it later in the flow." },
  { title: "YAML or editor", body: "Flows are YAML files too. Edit them by hand or in the app." },
];

const features = [
  { title: "Lightweight", body: "Small download, quick to open, easy on memory." },
  { title: "YAML files", body: "One file per request, in the same layout Bruno uses." },
  { title: "Git", body: "Status, diffs, staging, commits and branches." },
  { title: "Run view", body: "See the request and response for each step as a flow runs." },
  { title: "Environments", body: "Variables and secrets at the collection, environment, folder or request level." },
  { title: "CLI", body: "For CI. Outputs JSON or JUnit." },
  { title: "History", body: "Past responses are saved per request." },
  { title: "Import", body: "Postman collections, OpenAPI 3 and Swagger 2." },
];

const windowsIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4.5v7H3zm0 13 7.5 1v-7H3zm8.5 1.1L21 21v-8.5h-9.5zm0-15.2V11.5H21V3z"/></svg>`;
const appleIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.6 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4zM13.9 5c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.3z"/></svg>`;
const downloadIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>cactus · the file-based API client</title>
    <meta name="description" content="The file-based API client. Requests as plain files. Works with Git, your editor, and your agents." />
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="logo" href="/"><img src="/favicon.svg" alt="" />cactus</a>
        <nav>
          <a href="#flows">Flows</a>
          <a href="#features">Features</a>
          <a href="#download">Download</a>
        </nav>
      </header>

      <div class="hero" id="download">
        <h1>A <span class="accent">fast, lightweight</span><br />API client</h1>
        <p>Requests are YAML files in your repo. Chain them into flows and build tools around them.</p>
        <div class="buttons">
          <a class="btn primary" href={downloads.macos}><Fragment set:html={appleIcon} />Download for macOS</a>
          <a class="btn primary" href={downloads.windowsInstaller}><Fragment set:html={windowsIcon} />Download for Windows</a>
        </div>
        <p class="alt">
          Windows without installing? <a href={downloads.windowsStandalone}><Fragment set:html={downloadIcon} />Standalone .exe</a>
        </p>
        <div class="shot"><img src="/request.png" alt="cactus showing a request and its response headers" width="2558" height="1596" /></div>
      </div>
    </div>

    <section id="flows">
      <div class="wrap">
        <h2>Build tools around your APIs</h2>
        <p class="lead">A flow can ask for input, let you pick from a list, call a few endpoints and show you the result. Run it yourself, put it on a schedule, or hand it to your AI agent.</p>
        <div class="shot flow-shot"><img src="/flow.png" alt="The flow editor with a request, an assert and a Slack step" width="2558" height="1596" loading="lazy" /></div>
        <div class="features">
          {flowPoints.map((f) => (
            <div class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <h2>Everything else</h2>
        <div class="features">
          {features.map((f) => (
            <div class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Michael Rausch</span>
        <a href="#download">Download</a>
      </div>
    </footer>
  </body>
</html>
