---
import "../styles/global.css";
import { KOFI_PRO_URL, proDownloads } from "../downloads";

const features = [
  { title: "Security tooling", body: "Flow steps for fuzzing, security headers, certificates, rate limits and load testing." },
  { title: "Slack and webhooks", body: "Post a flow's results to Slack or any URL." },
  { title: "Extra themes", body: "24 more, from Synthwave to Windows 95." },
  { title: "Early access", body: "New features land in Pro first." },
];

const windowsIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4.5v7H3zm0 13 7.5 1v-7H3zm8.5 1.1L21 21v-8.5h-9.5zm0-15.2V11.5H21V3z"/></svg>`;
const appleIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.6 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4zM13.9 5c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.3z"/></svg>`;
const downloadIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>`;
const heartIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 5.3 3.1 1.7-1.9 3.2-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>cactus pro</title>
    <meta name="description" content="cactus pro: security tooling, Slack and webhooks, extra themes and early access. Support cactus on Ko-fi for a license key." />
    <script is:inline>
      const ua = navigator.userAgent;
      const os = /Macintosh|iPhone|iPad/.test(ua) ? "mac" : /Windows/.test(ua) ? "windows" : "";
      if (os) document.documentElement.dataset.os = os;
    </script>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="logo" href="/"><img src="/favicon.svg" alt="" />cactus</a>
        <nav>
          <a href="/pro"><span class="badge">Pro</span></a>
          <a href="https://docs.usecactus.dev">Docs</a>
          <a href="https://github.com/michaelrausch/cactus">GitHub</a>
          <a class="btn primary" href="/#download">Download</a>
        </nav>
      </header>

      <div class="hero">
        <h1>cactus <span class="badge">Pro</span></h1>
        <p>cactus is donationware. If you want to support it, buy cactus pro on Ko-fi. Pro adds security testing, Slack and webhook steps, more themes and early access to new features.</p>
        <div class="buttons">
          <a class="btn primary" href={KOFI_PRO_URL}><Fragment set:html={heartIcon} />Get cactus pro</a>
          <a class="btn dl-mac" href={proDownloads.macos}><Fragment set:html={appleIcon} />Download Pro for macOS</a>
          <a class="btn dl-win" href={proDownloads.windowsInstaller}><Fragment set:html={windowsIcon} />Download Pro for Windows</a>
        </div>
        <a class="dl-link dl-mac-link" href={proDownloads.macos}>Download Pro for macOS instead</a>
        <a class="dl-link dl-win-link" href={proDownloads.windowsInstaller}>Download Pro for Windows instead</a>
        <p class="alt dl-win">
          Windows without installing? <a href={proDownloads.windowsStandalone}><Fragment set:html={downloadIcon} />Standalone Pro .exe</a>
        </p>
      </div>
    </div>
    <svg class="scene" viewBox="0 0 1440 240" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path d="M0 150 C 260 96, 460 100, 700 138 S 1140 170, 1440 112 L1440 240 L0 240 Z" fill="#e3d6bb" />
      <g fill="none" stroke="#3d6b4c" stroke-width="22" stroke-linecap="round" stroke-linejoin="round">
        <path d="M300 200 V 98" />
        <path d="M300 158 H 270 V 124" stroke-width="16" />
        <path d="M300 140 H 332 V 108" stroke-width="16" />
        <path d="M1180 210 V 150" stroke-width="16" />
        <path d="M1180 180 H 1160 V 150" stroke-width="12" />
        <path d="M1180 178 H 1198 V 156" stroke-width="12" />
      </g>
      <path d="M0 190 C 300 160, 600 176, 880 196 S 1280 180, 1440 170 L1440 240 L0 240 Z" fill="#ebe2d0" />
    </svg>

    <section class="tight band">
      <div class="wrap">
        <h2>What's in <span class="badge">Pro</span></h2>
        <ul class="list">
          {features.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Michael Rausch</span>
        <span class="footer-links">
          <a href="https://docs.usecactus.dev">Docs</a>
          <a href="https://github.com/michaelrausch/cactus">GitHub</a>
          <a href="/#download">Download</a>
        </span>
      </div>
    </footer>
  </body>
</html>
