---
import "../../styles/global.css";
import { KOFI_URL, proDownloads } from "../../downloads";

const windowsIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4.5v7H3zm0 13 7.5 1v-7H3zm8.5 1.1L21 21v-8.5h-9.5zm0-15.2V11.5H21V3z"/></svg>`;
const appleIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.6 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4zM13.9 5c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.3z"/></svg>`;
const downloadIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Thanks · cactus pro</title>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="logo" href="/"><img src="/favicon.svg" alt="" />cactus</a>
        <nav>
          <a href="/pro"><span class="badge">Pro</span></a>
          <a href="https://docs.usecactus.dev">Docs</a>
          <a href="https://github.com/michaelrausch/cactus">GitHub</a>
          <a class="btn primary" href="/#download">Download</a>
        </nav>
      </header>

      <div class="hero">
        <h1>Thanks for supporting <span class="accent">cactus</span></h1>
        <p>Your cactus pro license key is on its way. Here's how to start using it.</p>
      </div>
    </div>

    <section class="tight">
      <div class="wrap">
        <ol class="steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Check your email</h3>
              <p>
                Your key comes from <span class="mono">licenses@usecactus.dev</span>, usually within a minute, to the
                address you gave Ko-fi. If it's not there, check your spam folder.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Download cactus pro</h3>
              <p>It replaces cactus if you already have it, and keeps your projects and settings.</p>
              <div class="buttons start">
                <a class="btn" href={proDownloads.macos}><Fragment set:html={appleIcon} />macOS</a>
                <a class="btn" href={proDownloads.windowsInstaller}><Fragment set:html={windowsIcon} />Windows</a>
              </div>
              <p class="alt-line">
                Windows without installing? <a href={proDownloads.windowsStandalone}><Fragment set:html={downloadIcon} />Standalone .exe</a>
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Paste in your key</h3>
              <p>Open cactus pro, paste the key from the email and press Activate. It works offline, on any version.</p>
            </div>
          </li>
        </ol>
        <p class="help">
          No email after 10 minutes, or the key won't activate? <a href={KOFI_URL}>Message me on Ko-fi</a> and I'll sort it out.
        </p>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Michael Rausch</span>
        <span class="footer-links">
          <a href="https://docs.usecactus.dev">Docs</a>
          <a href="https://github.com/michaelrausch/cactus">GitHub</a>
          <a href="/#download">Download</a>
        </span>
      </div>
    </footer>
  </body>
</html>
